generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Business {
  id                      String          @id @default(cuid())
  name                    String
  slug                    String          @unique
  email                   String
  phone                   String?
  address                 String?
  country                 String          @default("GB") // "GB", "NG", "US", "DE", etc.
  currency                String          @default("GBP") // "GBP", "NGN", "EUR", "USD"
  paymentGateway          String          @default("MANUAL") // "MANUAL" | "PAYSTACK" | "STRIPE"
  paystackPublicKey       String?
  paystackSecretKey       String?         // Stored encrypted (AES-256-GCM)
  paystackSubaccountCode  String?         // Paystack Subaccount code e.g. "ACCT_xxxx"
  bankName                String?         // Settlement bank name e.g. "Guaranty Trust Bank"
  bankCode                String?         // Settlement bank 3-digit CBN code e.g. "058"
  bankAccountNumber       String?         // 10-digit NUBAN
  bankAccountName         String?         // Verified account name from Paystack resolve
  stripePublishableKey    String?
  stripeSecretKey         String?         // Stored encrypted (AES-256-GCM)
  paymentsEnabled         Boolean         @default(false)
  googleReviewUrl         String?
  paymentDetails          String?         // JSON stringified structured bank details or legacy text
  quoteFollowUpDelayDays  Int             @default(3)
  reviewReminderDelayDays Int             @default(4)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  users                   User[]
  leads                   Lead[]
  quotes                  Quote[]
  jobs                    Job[]
  invoices                Invoice[]
  reviewRequests          ReviewRequest[]
  activityLogs            ActivityLog[]
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  businessId   String
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String
  expires   DateTime
  createdAt DateTime @default(now())
}

// SQLite does not support native enums — stored as String; enforced in application code
// LeadStatus: NEW | CONTACTED | QUOTED | WON | LOST
// QuoteStatus: DRAFT | SENT | ACCEPTED | DECLINED
// JobStatus: SCHEDULED | IN_PROGRESS | COMPLETE
// InvoiceStatus: DRAFT | SENT | PAID | OVERDUE
// ReviewStatus: PENDING | SENT | REMINDER_SENT

model Lead {
  id           String        @id @default(cuid())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerName String
  phone        String
  email        String
  serviceType  String
  description  String
  source       String?
  status       String        @default("NEW")
  quotes       Quote[]
  jobs         Job[]
  invoices     Invoice[]
  activityLogs ActivityLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([businessId, status])
}

model Quote {
  id             String        @id @default(cuid())
  leadId         String
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  businessId     String
  business       Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  quoteToken     String        @unique
  lineItems      String        // JSON stringified array of line items
  subtotal       Int           // in smallest unit (£1.00 = 100, ₦1.00 = 100)
  total          Int           // in smallest unit
  currency       String        @default("GBP") // "GBP", "NGN", "EUR", "USD"
  status         String        @default("DRAFT") // DRAFT | SENT | ACCEPTED | DECLINED
  sentAt         DateTime?
  followUpSentAt DateTime?
  acceptedAt     DateTime?
  declinedAt     DateTime?
  jobs           Job[]
  invoices       Invoice[]
  activityLogs   ActivityLog[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([businessId, status, sentAt])
}

model Job {
  id             String          @id @default(cuid())
  quoteId        String?
  quote          Quote?          @relation(fields: [quoteId], references: [id])
  leadId         String?
  lead           Lead?           @relation(fields: [leadId], references: [id])
  businessId     String
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerName   String
  customerEmail  String
  customerPhone  String
  description    String
  lineItems      String?         // JSON stringified
  amount         Int             // in smallest unit
  currency       String          @default("GBP") // "GBP", "NGN", "EUR", "USD"
  scheduledDate  DateTime?
  status         String          @default("SCHEDULED") // SCHEDULED | IN_PROGRESS | COMPLETE
  completedAt    DateTime?
  invoices       Invoice[]
  reviewRequests ReviewRequest[]
  activityLogs   ActivityLog[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([businessId, status, scheduledDate])
}

model Invoice {
  id                  String          @id @default(cuid())
  jobId               String?
  job                 Job?            @relation(fields: [jobId], references: [id])
  quoteId             String?
  quote               Quote?          @relation(fields: [quoteId], references: [id])
  leadId              String?
  lead                Lead?           @relation(fields: [leadId], references: [id])
  businessId          String
  business            Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerName        String
  customerEmail       String
  invoiceNumber       String          // e.g. "INV-001"
  lineItems           String          // JSON stringified
  subtotal            Int             // in pence/kobo/cents (smallest currency unit)
  total               Int             // in pence/kobo/cents
  currency            String          @default("GBP") // "GBP", "NGN", "EUR", "USD"
  paymentLinkUrl      String?
  paymentReference    String?         @unique
  gatewayPaymentId    String?
  status              String          @default("DRAFT") // DRAFT | SENT | PAID | OVERDUE
  sentAt              DateTime?
  paidAt              DateTime?
  dueDate             DateTime
  emailDeliveryStatus String          @default("PENDING") // PENDING | DELIVERED | BOUNCED
  reviewRequests      ReviewRequest[]
  activityLogs        ActivityLog[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([businessId, status, dueDate])
  @@index([paymentReference])
}

model ReviewRequest {
  id               String    @id @default(cuid())
  invoiceId        String
  invoice          Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  jobId            String?
  job              Job?      @relation(fields: [jobId], references: [id])
  businessId       String
  business         Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerName     String
  customerEmail    String
  status           String    @default("PENDING") // PENDING | SENT | REMINDER_SENT
  sentAt           DateTime?
  reminderSentAt   DateTime?
  unsubscribeToken String    @unique
  unsubscribedAt   DateTime?
  createdAt        DateTime  @default(now())

  @@index([businessId, status, sentAt])
}

model ActivityLog {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  leadId     String?
  lead       Lead?     @relation(fields: [leadId], references: [id])
  quoteId    String?
  quote      Quote?    @relation(fields: [quoteId], references: [id])
  jobId      String?
  job        Job?      @relation(fields: [jobId], references: [id])
  invoiceId  String?
  invoice    Invoice?  @relation(fields: [invoiceId], references: [id])
  entityType String    // "lead" | "quote" | "job" | "invoice" | "review"
  entityId   String
  eventType  String    // e.g. "job.created" | "job.status_complete" | "invoice.drafted" | "invoice.sent" | "invoice.paid"
  status     String    @default("SUCCESS") // "SUCCESS" | "FAILURE"
  detail     String?
  occurredAt DateTime  @default(now())
}
