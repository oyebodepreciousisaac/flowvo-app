# ─── Flowvo Environment Variables ────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/flowvo"

# ─── App URL (used in email links and CSRF origin check) ──────────────────────
NEXTAUTH_URL="http://localhost:3000"

# ─── Email (Resend / Nodemailer) ──────────────────────────────────────────────
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@yourdomain.com"

# ─── Cloudflare Turnstile (enquiry form CAPTCHA) ──────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x..."
TURNSTILE_SECRET_KEY="0x..."

# ─── Cron job authentication ──────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET="replace_with_64_char_hex_string"

# ─── Field-level encryption (paymentDetails and sensitive fields at rest) ──────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Changing this key will make all existing encrypted data unreadable.
# Store a backup of the key securely (e.g., in a password manager / secret vault).
FIELD_ENCRYPTION_KEY="replace_with_64_char_hex_string"
